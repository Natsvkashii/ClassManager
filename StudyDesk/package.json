{
  "name": "studydesk",
  "productName": "StudyDesk",
  "version": "26.11.0-005",
  "description": "StudyDesk – piattaforma modulare di esercizi interattivi per corsi di lingua",
  "author": {
    "name": "Guaira Jaramillo Nitoglia",
    "email": "guaira.jaramillo.nitoglia@gmail.com"
  },
  "license": "GPL-3.0-only",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.js",
    "test": "node --test \"tests/*.test.js\"",
    "vendor": "node scripts/copy-vendor.js",
    "dist:win": "electron-builder --win --x64",
    "android:sync": "npx cap sync android",
    "android:apk": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "sample": "node scripts/build-sample.js"
  },
  "build": {
    "appId": "com.guairajaramillo.studydesk",
    "productName": "StudyDesk",
    "copyright": "© 2026 Guaira Jaramillo Nitoglia – GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "app/**",
      "package.json",
      "LICENSE"
    ],
    "fileAssociations": [
      {
        "ext": "sdmod",
        "name": "Modulo StudyDesk",
        "role": "Viewer"
      },
      {
        "ext": "sdbook",
        "name": "Libro StudyDesk",
        "role": "Viewer"
      },
      {
        "ext": "sdgroup",
        "name": "Invito gruppo StudyDesk",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "artifactName": "StudyDesk-${version}-mac.${ext}",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StudyDesk-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudyDesk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bonjour-service": "^1.4.4",
    "jszip": "^3.10.1"
  }
}

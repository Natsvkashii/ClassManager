{
  "name": "hubdesk",
  "productName": "HubDesk",
  "version": "26.11.1-015",
  "description": "HubDesk – il centro della suite ClassDesk (gestione app, rete, lavagna condivisa)",
  "author": {
    "name": "Guaira Jaramillo Nitoglia",
    "email": "guaira.jaramillo.nitoglia@gmail.com"
  },
  "license": "GPL-3.0-only",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/copy-shared.js",
    "start": "node scripts/copy-shared.js && electron .",
    "test": "node --test \"tests/*.test.js\"",
    "icons": "node scripts/gen-icon.js",
    "dist:win": "node scripts/dist.js"
  },
  "build": {
    "appId": "com.guairajaramillo.hubdesk",
    "productName": "HubDesk",
    "copyright": "© 2026 Guaira Jaramillo Nitoglia – GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "net/**",
      "catalog/**",
      "renderer/**",
      "shared/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ClassDesk-Suite-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "HubDesk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": null
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestione Corsi",
  "version": "1.0.0",
  "identifier": "com.guairajaramillonitoglia.gestionecorsi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Gestione Corsi v1.0.0",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Piattaforma Accademica Multi-Livello QCER",
    "longDescription": "Gestione Corsi v1.0.0 — Concepito e Sviluppato da Guaira Jaramillo Nitoglia (guaira.jaramillo.nitoglia@gmail.com)"
  }
}

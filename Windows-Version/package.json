{
  "name": "class-management",
  "version": "26.10.0-2",
  "description": "Class Management v26.10.0-2 — Piattaforma Accademica Multi-Livello QCER (Presenze, Piano Lezioni, Voti, Attività, Griglie di Valutazione, Calendario Modulo Drag & Drop, Cestino 30gg, Anagrafica, Fatturazione)",
  "author": {
    "name": "Guaira Jaramillo Nitoglia",
    "email": "guaira.jaramillo.nitoglia@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.guairajaramillonitoglia.classmanagement",
    "productName": "Class Management",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/AppIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Class Management",
      "uninstallDisplayName": "Class Management",
      "artifactName": "Class-Management-26.10.0-2-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Class-Management-26.10.0-2-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
